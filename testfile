stage('validate: manifest') {
    logStage("validate-manifest")

    def fileType = 'manifest'     // or 'vars' depending on QA pipeline type
    def manifestMap = getFoundationManifests(fileType)   // returns map for entire env

    manifestMap.each { suffix, pcfManifest ->

        // Special rule: ProdDal & ProdPhx → use NP splunk validation
        def envType = (suffix == 'ProdDal' || suffix == 'ProdPhx') ? 'np' : 'prod'

        println "Validating ${suffix} => ${pcfManifest} with splunk index type ${envType}"

        if (fileExists(pcfManifest)) {
            validateSplunkIndex(pcfManifest, envType)
        } else {
            buildFailed("No manifest file found: ${pcfManifest}")
        }
    }
}


