def call(def manifestFileName, def indexType) {

    def data = readYaml file: manifestFileName

    // ---------------------------------------------------
    // CASE 1: env.SPLUNK_INDEX
    // ---------------------------------------------------
    if (data?.env?.SPLUNK_INDEX) {

        def splIndex = data.env.SPLUNK_INDEX.toLowerCase()

        // CORRECT LOGIC: fail only if NOT matching
        if (!splIndex.contains(indexType.toLowerCase())) {
            buildFailed("The manifest file '${manifestFileName}' contains disallowed Splunk index '${splIndex}'.\n" +
                        "Action Required: Please update the Splunk index to contain '${indexType}'")
        }

    }

    // ---------------------------------------------------
    // CASE 2: applications.env.SPLUNK_INDEX[0]
    // ---------------------------------------------------
    else if (data?.applications?.env?.SPLUNK_INDEX) {

        def splIndex = data.applications.env.SPLUNK_INDEX[0].toLowerCase()

        if (!splIndex.contains(indexType.toLowerCase())) {
            buildFailed("The manifest file '${manifestFileName}' contains disallowed Splunk index '${splIndex}'.\n" +
                        "Action Required: Please update the Splunk index to contain '${indexType}'")
        }

    }

    // ---------------------------------------------------
    // CASE 3: "splunk-index"
    // ---------------------------------------------------
    else if (data?."splunk-index") {

        def splIndex = data."splunk-index".toLowerCase()

        if (!splIndex.contains(indexType.toLowerCase())) {
            buildFailed("The manifest file '${manifestFileName}' contains disallowed Splunk index '${splIndex}'.\n" +
                        "Action Required: Please update the Splunk index to contain '${indexType}'")
        }

    }

    // ---------------------------------------------------
    // CASE 4: None found
    // ---------------------------------------------------
    else {
        buildFailed("No SPLUNK_INDEX found in manifest file '${manifestFileName}'")
    }
}
