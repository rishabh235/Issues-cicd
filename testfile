stage('udeploy: import-artifact') {
    logStage('udeploy-import-artifact') {

        def fileType = 'manifest'
        def manifestMap = getFoundationManifests(null, fileType)

        // Expected suffixes for QA pipeline
        def expectedSuffixes = [
            'QAEast', 'QAWest', 
            'QA1East1', 'QA1East2',
            'UATEast', 'UATWest', 
            'UAT1East1', 'UAT1East2',
            'ProdDal', 'ProdPhx'
        ]

        // Dynamically create variables for each manifest file
        expectedSuffixes.each { suffix ->
            def varName = "pcfManifestFile${suffix}"
            def value = manifestMap.containsKey(suffix) ? manifestMap[suffix] : ""
            this."${varName}" = value
        }

        // Pass everything to import function
        uDeployProdVersionImportAWS(
            gitProjectKey,
            gitRepositoryName,
            appVersion,

            pcfManifestFileQAEast,
            pcfManifestFileQAWest,

            pcfManifestFileQA1East1,
            pcfManifestFileQA1East2,

            pcfManifestFileUATEast,
            pcfManifestFileUATWest,

            pcfManifestFileUAT1East1,
            pcfManifestFileUAT1East2,

            pcfManifestFileProdDal,
            pcfManifestFileProdPhx
        )
    }
}
