def call(def repositoryName, def repositoryId, def groupId, def artifactId, def appVersion) {

    def envProperty      = loadEnvironmentProperties()
    def mavenTool        = envProperty.maven_upload_tool
    def defaultJdk       = envProperty.default_jdk
    def nexusRepoBaseUrl = envProperty.nexus_repo_base_url
    def buildType        = getAppBuildType()

    println "INFO: Nexus artifact uploading to repository: ${repositoryName}"
    println "INFO: The app version uploading to Nexus repository: ${appVersion}"
    println "INFO: Build type detected: ${buildType}"

    // Snapshot validation
    if (repositoryName.contains("snapshots") && !appVersion.contains("SNAPSHOT")) {
        buildFailed(
            "Attempting to upload a non-snapshot version to the Nexus snapshot repository.\n" +
            "Action Required: Please ensure that only 'SNAPSHOT' versions are pushed."
        )
    }

    withEnv([
            "JAVA_HOME=${tool defaultJdk}",
            "PATH+MAVEN=${tool defaultJdk}/bin:${tool mavenTool}/bin"
    ]) {

        // ------------------------------
        // IF BUILD TYPE IS MAVEN
        // ------------------------------
        if (buildType == "maven") {

            // 1) versions:set
            sh "mvn versions:set -q -DnewVersion=${appVersion}"

            // 2) deploy-file with pom.xml
            sh """
                mvn -V -B -e deploy:deploy-file \
                    -DpomFile=pom.xml \
                    -Durl=${nexusRepoBaseUrl}/${repositoryName}/ \
                    -DrepositoryId=${repositoryId} \
                    -DgroupId=${groupId} \
                    -DartifactId=${artifactId} \
                    -Dversion=${appVersion} \
                    -Dpackaging=jar \
                    -Dfile=target/${artifactId}-${appVersion}.jar
            """

            // 3) versions:revert
            sh "mvn versions:revert -q"
        }

        // ------------------------------
        // IF BUILD TYPE IS GRADLE
        // ------------------------------
        else if (buildType == "gradle") {

            // Only 1 mvn command + generatePom=true
            sh """
                mvn -V -B -e deploy:deploy-file \
                    -DgeneratePom=true \
                    -Durl=${nexusRepoBaseUrl}/${repositoryName}/ \
                    -DrepositoryId=${repositoryId} \
                    -DgroupId=${groupId} \
                    -DartifactId=${artifactId} \
                    -Dversion=${appVersion} \
                    -Dpackaging=jar \
                    -Dfile=build/libs/${artifactId}-${appVersion}.jar
            """
        }

        // ------------------------------
        // UNKNOWN BUILD TYPE
        // ------------------------------
        else {
            buildFailed("This type of build type '${buildType}' is not supported by this pipeline")
        }
    }
}





stage('nexus: publish artifact') {
    logStage('nexus-publish-artifact') {

        // TRY TO LOAD pom.xml — return null if it doesn't exist (Gradle case)
        def pom = fileExists('pom.xml') ? readMavenPom(file: 'pom.xml') : null

        if (pom != null && pom.packaging.toString().contains('pom')) {
            println "INFO: Uploading the ${pom.packaging.toString()} to Nexus artifact repo"
            nexusArtifactoryPomUpload(
                'snapshots',
                'internalMavenSnapshotRepository',
                getAppGroupId(),
                getAppArtifactId(),
                appVersion
            )

        } else {
            // THIS RUNS FOR:  
            // ✔ Maven JAR modules  
            // ✔ Gradle (NO pom.xml)  
            println "INFO: Uploading artifact (jar) to Nexus"

            nexusArtifactoryUpload(
                'snapshots',
                'internalMavenSnapshotRepository',
                getAppGroupId(),
                getAppArtifactId(),
                appVersion
            )
        }
    }
}
