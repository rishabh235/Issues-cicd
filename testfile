def call() {

    // Run only for PR builds
    if (!env.CHANGE_ID) {
        echo "Not a PR build. Skipping single-commit validation."
        return
    }

    echo "PR detected: #${env.CHANGE_ID}"
    echo "Source Branch : ${env.CHANGE_BRANCH}"
    echo "Target Branch : ${env.CHANGE_TARGET}"

    // Ensure target branch is available locally
    sh """
        git fetch origin ${env.CHANGE_TARGET}
    """

    // Count commits in PR
    def commitCount = sh(
        script: """
            git rev-list --count origin/${env.CHANGE_TARGET}..HEAD
        """,
        returnStdout: true
    ).trim().toInteger()

    echo "Commit count in PR: ${commitCount}"

    if (commitCount > 1) {
        error """
❌ PR POLICY VIOLATION

This Pull Request contains ${commitCount} commits.
Only ONE commit is allowed per PR.

👉 Please squash your commits before raising the PR.

How to fix:
git rebase -i origin/${env.CHANGE_TARGET}
# squash commits
git push -f

Target branch : ${env.CHANGE_TARGET}
Source branch : ${env.CHANGE_BRANCH}
"""
    }

    echo "✅ PR commit validation passed (single commit)"
}
