stage('Check All Commits Squashed') {
    when { expression { return params.SKIP_SQUASH_COMMIT_VALIDATION == false } }
    steps {
        script {

            echo "🔍 Checking commit count for PR ID: ${gitPullRequestId}"

            // Bitbucket API call
            def response = sh(
                script: """
                    curl -s --location \
                      --header "Authorization: Bearer ${BITBUCKET_ACCESS_TOKEN}" \
                      --header "Accept: application/json" \
                      "https://bitbucket.glb.syfbank.com/rest/api/1.0/projects/${gitProjectKey}/repos/${gitRepositoryName}/pull-requests/${gitPullRequestId}/commits"
                """,
                returnStdout: true
            )

            def parsedResponse = readJSON text: response
            int commitCount = parsedResponse.values.size()

            echo "📌 Total commits detected in PR: ${commitCount}"

            if (commitCount > 1) {
                echo "❌ There are multiple commits in this Pull Request. Please squash into a single commit."
                currentBuild.result = 'FAILURE'
                error("Stopping pipeline due to non-squashed commits.")
            } else {
                echo "✔ Squash validation passed — only 1 commit found."
            }
        }
    }
}
