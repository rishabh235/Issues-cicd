stage('validate: manifest') {
    logStage('validate-manifest')

    def manifestList = getFoundationManifests(pcfFoundation, "vars")

    manifestList.each { manifestFile ->
        println "Validating manifest: ${manifestFile}"

        if (fileExists(manifestFile)) {
            validateSplunkIndex(manifestFile, 'prod')   // ✅ Do NOT change logic
        } else {
            buildFailed("No manifest file found: ${manifestFile}")
        }
    }
}



stage('udeploy: import artifact') {
    logStage('udeploy-import-artifact')

    def fileType = "vars"
    def pcfManifestFile

    if (pcfFoundation.equalsIgnoreCase("east-1-dev1")) {
        pcfManifestFile = getFoundationManifests("east-1-dev1", fileType)[0]

    } else if (pcfFoundation.equalsIgnoreCase("east-2-dev1")) {
        pcfManifestFile = getFoundationManifests("east-2-dev1", fileType)[0]

    } else {
        pcfManifestFile = getFoundationManifests("dev-west", fileType)[0]
    }

    println "Using ${fileType} file for ${pcfFoundation}: ${pcfManifestFile}"

    uDeployDevVersionImport(
        gitRepositoryName,
        appVersion,
        pcfManifestFile,
        pcfRoute
    )
}



