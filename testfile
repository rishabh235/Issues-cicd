stage('udeploy: Import-artifact') {
    logStage('udeploy-import-artifact') {
        script {
            // You can control this using a pipeline parameter or logic
            // e.g. fileType = "vars" or "manifest"
            def fileType = "manifest"  // 🔹 change to "vars" if that pipeline uses vars type

            def pcfManifestFile = ""

            if (pcfFoundation.equalsIgnoreCase('east-1-dev1')) {
                pcfManifestFile = getFoundationManifests('east-1-dev1', fileType)[0]
            } else if (pcfFoundation.equalsIgnoreCase('east-2-dev1')) {
                pcfManifestFile = getFoundationManifests('east-2-dev1', fileType)[0]
            } else {
                pcfManifestFile = getFoundationManifests('dev-west', fileType)[0]
            }

            echo "📦 Using ${fileType} file for ${pcfFoundation}: ${pcfManifestFile}"

            // Pass to your import function
            uDeployDevVersionImport(gitRepositoryName, appVersion, pcfManifestFile, pcfRoute)
        }
    }
}
