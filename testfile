        def manifestMap = getFoundationManifests(null, 'manifest')  // returns Map

        manifestMap.each { suffix, pcfManifest ->

            def envType = (suffix == 'ProdDal' || suffix == 'ProdPhx') ? 'np' : 'prod'

            if (fileExists(pcfManifest)) {
                validateSplunkIndex(pcfManifest, envType)
