stage('udeploy: import-artifact') {
    logStage('udeploy-import-artifact') {

        def fileType = 'manifest'

        // Get ALL manifests for QA
        def manifestList = getFoundationManifests(null, fileType)

        // Convert to a map: key → file
        def manifestMap = manifestList.collectEntries { item ->
            [(item.key): item.file]
        }

        // Pass the MAP directly to uDeploy
        uDeployProdVersionImportAWS(
            gitProjectKey,
            gitRepositoryName,
            appVersion,
            manifestMap
        )
    }
}



