withEnv(["JAVA_HOME=${tool defaultJdk}", "PATH+MAVEN=${tool defaultJdk}/bin:${tool mavenTool}/bin"]) {

    // Detect file to upload (maven or gradle)
    def pomFilePath = "pom.xml"
    if (!fileExists("pom.xml") && fileExists("build/publications/mavenJava/pom-default.xml")) {
        pomFilePath = "build/publications/mavenJava/pom-default.xml"
        println "INFO: Detected Gradle BOM. Uploading ${pomFilePath}"
    } else {
        println "INFO: Detected Maven project. Uploading pom.xml"
    }

    // Only Maven BOM needs version set & revert
    if (pomFilePath == "pom.xml") {
        sh "mvn versions:set -q -DnewVersion=${appVersion}"
    }

    sh """
        mvn -V -B -e deploy:deploy-file \
        -Dfile=${pomFilePath} \
        -Durl=${nexusRepoBaseUrl}/${repositoryName}/ \
        -DrepositoryId=${repositoryId} \
        -DgroupId=${groupId} \
        -DartifactId=${artifactId} \
        -Dversion=${appVersion} \
        -Dpackaging=pom
    """

    if (pomFilePath == "pom.xml") {
        sh "mvn versions:revert -q"
    }
}


