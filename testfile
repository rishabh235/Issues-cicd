def call(String targetBranch, String prId, boolean forceCheck = false) {

    // Decide whether to run validation
    if (!forceCheck && (!prId || prId == 'NA')) {
        echo "Not a PR build and FORCE_ATOMIC_CHECK=false. Skipping atomic commit validation."
        return
    }

    if (!targetBranch?.trim()) {
        error "Target branch is empty. Cannot validate atomic commit."
    }

    targetBranch = targetBranch.replaceAll('^refs/heads/', '')

    echo "Validating atomic commit against branch: ${targetBranch}"
    echo "PR ID: ${prId ?: 'N/A'} | Force check: ${forceCheck}"

    sh "git fetch origin ${targetBranch}"

    def commitCount = sh(
        script: "git rev-list --count origin/${targetBranch}..HEAD",
        returnStdout: true
    ).trim()

    echo "Commit count in branch diff: ${commitCount}"

    if (commitCount.toInteger() > 1) {
        error """
❌ ATOMIC COMMIT ENFORCEMENT FAILED
Branch '${targetBranch}' introduces ${commitCount} commits.
Please squash commits before merge.
        """
    }

    echo "✅ Atomic commit validation passed."
}
