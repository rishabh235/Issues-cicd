stage('validate: manifest') {
    logStage('validate-manifest')
    script {
        // 🟩 Step 1: Dynamically fetch manifests for the selected foundation
        def manifestList = getFoundationManifests(pcfFoundation, "manifest")

        // Normalize to list (in case only one file is returned)
        def manifests = (manifestList instanceof List) ? manifestList : [manifestList]

        // 🟩 Step 2: Validate each manifest for the selected foundation
        manifests.each { manifestFile ->
            echo "🔍 Validating manifest: ${manifestFile}"
            if (fileExists(manifestFile)) {
                validateSplunkIndex(manifestFile, 'dev')
            } else {
                buildFailed("❌ No manifest file found: ${manifestFile}")
            }
        }
    }
}



