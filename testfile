def validateSingleCommitInPR() {

    // Skip if not a PR build
    if (!env.CHANGE_ID && (gitPullRequestId == null || gitPullRequestId == 'NA')) {
        echo "Not a PR build. Skipping atomic commit validation."
        return
    }

    // Resolve target branch dynamically
    def targetBranch = env.CHANGE_TARGET ?: gitBranch

    if (!targetBranch) {
        error "Unable to resolve target branch for PR. Atomic commit validation aborted."
    }

    echo "Validating atomic commit for PR against target branch: ${targetBranch}"

    sh "git fetch origin ${targetBranch}"

    def commitCount = sh(
        script: "git rev-list --count origin/${targetBranch}..HEAD",
        returnStdout: true
    ).trim()

    echo "Commit count in PR: ${commitCount}"

    if (commitCount.toInteger() > 1) {
        error("""
❌ ATOMIC COMMIT ENFORCEMENT FAILED
PR contains ${commitCount} commits.
Please squash commits before merging into '${targetBranch}'.
        """)
    }

    echo "✅ Atomic commit validation passed."
}
