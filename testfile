// BuildManager.groovy

def call(def appVersion, def gitRepositoryName) {

    def appBuildType = getAppBuildType()

    if (appBuildType == 'maven') {

        println "INFO: Build type detected as Maven — starting Maven build."
        buildMaven(appVersion)

    } else if (appBuildType == 'gradle') {

        println "INFO: Build type detected as Gradle — starting Gradle build."
        buildGradle(appVersion, gitRepositoryName)

    } else {

        println "ERROR: Invalid build type '${appBuildType}'. Cannot continue."
        error("Unsupported build type '${appBuildType}'. Build failed.")

    }
}




