def validateSingleCommitInPR(String targetBranch) {

    if (!gitPullRequestId || gitPullRequestId == 'NA') {
        echo "Not a PR build. Skipping atomic commit validation."
        return
    }

    if (!targetBranch?.trim()) {
        error "Target branch is empty. Cannot validate atomic commit."
    }

    // Remove refs/heads if passed accidentally
    targetBranch = targetBranch.replaceAll('^refs/heads/', '')

    echo "Validating atomic commit against target branch: ${targetBranch}"

    sh(script: "git fetch origin ${targetBranch}", label: "Fetch target branch")

    def commitCount = sh(
        script: "git rev-list --count origin/${targetBranch}..HEAD",
        returnStdout: true
    ).trim()

    echo "Commit count in PR: ${commitCount}"

    if (commitCount.toInteger() > 1) {
        error """
❌ ATOMIC COMMIT ENFORCEMENT FAILED
PR contains ${commitCount} commits.
Please squash commits before merging into '${targetBranch}'.
        """
    }

    echo "✅ Atomic commit validation passed."
}
