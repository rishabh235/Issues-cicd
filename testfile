def call() {

    // 🔒 HARD-CODED BASE BRANCH (change later if needed)
    def baseBranch = 'atomic-test'

    echo "Validating single-commit policy"
    echo "Base branch (hardcoded) : ${baseBranch}"

    // Current branch (for visibility only)
    def currentBranch = sh(
        script: 'git rev-parse --abbrev-ref HEAD',
        returnStdout: true
    ).trim()

    echo "Current checked-out branch : ${currentBranch}"

    // Ensure base branch is present locally
    sh "git fetch origin ${baseBranch}"

    // Count commits ahead of base branch
    def commitCount = sh(
        script: "git rev-list --count origin/${baseBranch}..HEAD",
        returnStdout: true
    ).trim().toInteger()

    echo "Commits ahead of ${baseBranch}: ${commitCount}"

    if (commitCount > 1) {
        error """
❌ COMMIT POLICY VIOLATION

Branch '${currentBranch}' has ${commitCount} commits ahead of '${baseBranch}'.
Only ONE commit is allowed before merge.

Please squash your commits.
"""
    }

    echo "✅ Single-commit validation passed"
}
