utility/vars/getManifestsMap.groovy
// returns a Map of suffix -> filename for given fileType ('vars' or 'manifest')
def call(String fileType = 'manifest') {
    def yamlText = libraryResource('pipeline-global-config/foundation-manifests.yml')
    def foundationData = readYaml text: yamlText

    def section = foundationData[fileType]
    if (!section) {
        error "No section '${fileType}' found in foundation-manifests.yml"
    }

    // section is a map: e.g. [QAEast: 'manifest-qa-east.yml', ...]
    echo "Loaded ${section.size()} entries for '${fileType}'"
    return section
}
