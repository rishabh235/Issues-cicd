def call() {

    // 🔒 HARD-CODED BRANCHES
    def SOURCE_BRANCH = 'atomic-test2'
    def TARGET_BRANCH = 'atomic-test'

    echo "========================================"
    echo "Hardcoded PR Commit Validation"
    echo "Source Branch : ${SOURCE_BRANCH}"
    echo "Target Branch : ${TARGET_BRANCH}"
    echo "========================================"

    // Clean + fetch everything
    sh '''
        git reset --hard
        git clean -fd
        git fetch --all
    '''

    // Ensure correct branch is checked out
    sh """
        git checkout ${SOURCE_BRANCH}
        git pull origin ${SOURCE_BRANCH}
    """

    // Count commits difference
    def commitCount = sh(
        script: "git rev-list --count origin/${TARGET_BRANCH}..origin/${SOURCE_BRANCH}",
        returnStdout: true
    ).trim().toInteger()

    echo "Commits from ${SOURCE_BRANCH} → ${TARGET_BRANCH}: ${commitCount}"

    if (commitCount > 1) {
        error """
❌ COMMIT POLICY FAILED

Branch '${SOURCE_BRANCH}' has ${commitCount} commits
that are not present in '${TARGET_BRANCH}'.

Only ONE commit is allowed.

👉 Please squash commits before merge.
"""
    }

    echo "✅ Commit policy passed (single commit)"
}
