stage('nexus: publish artifact') {

    logStage('nexus-publish-artifact') {

        def pom = fileExists('pom.xml')
            ? readMavenPom(file: 'pom.xml')
            : (
                fileExists("build/publications/mavenJava/${getAppArtifactId(gitRepositoryName)}-${appVersion}.pom")
                    ? readMavenPom(
                        file: "build/publications/mavenJava/${getAppArtifactId(gitRepositoryName)}-${appVersion}.pom"
                      )
                    : null
              )

        if (pom != null && pom.packaging.toString().contains('pom')) {

            println "INFO: Uploading the ${pom.packaging.toString()} to Nexus artifact repo"

            nexusArtifactoryPomUpload(
                'snapshots',
                'internalMavenSnapshotRepository',
                getAppGroupId(),
                getAppArtifactId(gitRepositoryName),
                appVersion
            )

        } else {

            println "INFO: Uploading artifact (jar) to Nexus"

            nexusArtifactoryUpload(
                'snapshots',
                'internalMavenSnapshotRepository',
                getAppGroupId(),
                getAppArtifactId(gitRepositoryName),
                appVersion
            )
        }
    }
}
