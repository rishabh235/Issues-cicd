def call(def jdkTool = null, def appVersion, def gitRepositoryName) {

    def envProperty = loadEnvironmentProperties()

    def jdkVersion = jdkTool ?: envProperty.default_jdk
    def gradleTool = envProperty.gradle_tool
    def nexusRepoGroupUrl = envProperty.nexus_repo_group_url
    def nexusRepoCredential = envProperty.nexus_repo_auth_credential_id

    def customArtifactName = getAppArtifactId(gitRepositoryName)

    // Copy init.gradle from shared library
    def gradleInitFileContent = libraryResource('pipeline-global-config/gradle-build-config/init.gradle')
    writeFile file: 'init.gradle', text: gradleInitFileContent

    println "INFO: Pipeline-managed Gradle init.gradle copied to workspace"

    withEnv([
        "JAVA_HOME=${tool jdkVersion}",
        "PATH+JAVA=${tool jdkVersion}/bin",
        "PATH+GRADLE=${tool gradleTool}/bin"
    ]) {

        withCredentials([
            usernamePassword(
                credentialsId: nexusRepoCredential,
                usernameVariable: 'USERNAME',
                passwordVariable: 'PASSWORD'
            )
        ]) {

            boolean isJarProject = fileExists('src')

            if (isJarProject) {

                println "INFO: src/ directory found → JAR project build"

                sh """
                    gradle clean build jacocoTestReport \\
                    --init-script init.gradle \\
                    -PcustomAppVersion=${appVersion} \\
                    -PcustomArtifactName=${customArtifactName} \\
                    -Dnexus_url=${nexusRepoGroupUrl} \\
                    -Dnexus_username=${USERNAME} \\
                    -Dnexus_password=${PASSWORD} \\
                    -g /appbin/install/Gradle_Cache/${gitRepositoryName}
                """

            } else {

                println "INFO: src/ directory NOT found → BOM/POM-only build"

                sh """
                    gradle clean generatePomFileForMavenJavaPublication \\
                    --init-script init.gradle \\
                    -PcustomAppVersion=${appVersion} \\
                    -PcustomArtifactName=${customArtifactName} \\
                    -Dnexus_url=${nexusRepoGroupUrl} \\
                    -Dnexus_username=${USERNAME} \\
                    -Dnexus_password=${PASSWORD} \\
                    -g /appbin/install/Gradle_Cache/${gitRepositoryName}
                """

                sh """
                    mv build/publications/mavenJava/pom-default.xml \
                       build/publications/mavenJava/${customArtifactName}-${appVersion}.pom
                """
            }
        }
    }

    // Publish test results only if present
    if (fileExists('build/test-results/test')) {
        junit allowEmptyResults: true,
              skipPublishingChecks: true,
              testResults: '**/build/test-results/test/*.xml'
    }
}
