def call(def fileType = "manifest", def pcfFoundation = null) {

    def yamlText = libraryResource('pipeline-global-config/foundation-manifests.yml')
    def foundationData = readYaml(text: yamlText)

    def typeSection = foundationData[fileType]
    if (!typeSection) {
        println "Section '${fileType}' not found. Returning empty."
        return []
    }

    // ============================
    // ✅ DEV PIPELINE MODE
    // ============================
    // pcfFoundation passed → return only its entries
    if (pcfFoundation) {

        def foundationKey = pcfFoundation.toString().toLowerCase()

        // Only DEV keys live under nonProd
        def nonProdMap = typeSection["nonProd"] ?: [:]

        // Lookup case-insensitive match
        def match = nonProdMap.find { k, v ->
            k.toLowerCase() == foundationKey
        }

        if (!match) {
            println "No mapping found for foundation '${pcfFoundation}'. Returning empty."
            return []
        }

        def value = match.value

        // Always return list for consistency
        return (value instanceof String) ? [value] : value
    }

    // ============================
    // ✅ QA PIPELINE MODE
    // ============================
    // No foundation passed → return ALL filenames
    def nonProdMap = typeSection["nonProd"] ?: [:]
    def prodMap    = typeSection["prod"]    ?: [:]

    // Only values that are actual filenames (Strings)
    def allFiles = (nonProdMap.values() + prodMap.values())
                      .findAll { it instanceof String }

    println "Flattened ${allFiles.size()} ${fileType} files for QA pipeline"

    return allFiles
}



