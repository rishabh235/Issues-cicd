def call(def gitProjectKey,
         def gitRepositoryName,
         def appVersion,
         Map manifestMap) {

    def envProperty = loadEnvironmentProperties()
    def jdkVersion = envProperty.default_jdk
    def uDeployUri = envProperty.udeploy_host_url
    def uDeployCli = envProperty.udeploy_cli_path
    def uDeployCredential = envProperty.udeploy_auth_credential_id
    def uDeployApplicationName = envProperty.udeploy_app_name
    def uDeployComponentName = "${uDeployApplicationName}${gitRepositoryName}"

    // Determine build type (maven/gradle)
    def uDeployArtifactName = ""
    if (getAppBuildType() == "maven") {
        uDeployArtifactName = findFiles(glob: "target/*.jar")[0].name
        uDeployComponentPropUpdate(uDeployComponentName, "BuildType", "Maven")
    } else if (getAppBuildType() == "gradle") {
        uDeployArtifactName = findFiles(glob: "build/libs/*.jar")[0].name
        uDeployComponentPropUpdate(uDeployComponentName, "BuildType", "Gradle")
    } else {
        buildFailed("Build type could not be detected. Must be maven or gradle.")
    }

    def uDeployComponentVersion = appVersion

    // ------------------------
    // Create Version in uDeploy
    // ------------------------
    withEnv(["JAVA_HOME=${tool jdkVersion}", "PATH+JAVA=${tool jdkVersion}/bin"]) {
        withCredentials([usernamePassword(credentialsId: uDeployCredential,
                                          usernameVariable: 'USERNAME',
                                          passwordVariable: 'PASSWORD')]) {

            // Create a new version
            sh """
                ${uDeployCli} \
                --weburl ${uDeployUri} \
                --username ${USERNAME} \
                --password ${PASSWORD} \
                createVersion \
                --component ${uDeployComponentName} \
                --version ${uDeployComponentVersion} \
                --description "Pushed from Jenkins"
            """

            // Upload artifacts
            sh """
                ${uDeployCli} \
                --weburl ${uDeployUri} \
                --username ${USERNAME} \
                --password ${PASSWORD} \
                addVersionFiles \
                --component ${uDeployComponentName} \
                --version ${uDeployComponentVersion} \
                --base . \
                --include target/${uDeployArtifactName} \
                --include build/libs/${uDeployArtifactName} \
                --include **/*.yml
            """

            // ------------------------
            // SET VERSION PROPERTIES
            // ------------------------
            def versionProperties = [
                "Jenkins.server"     : env.JENKINS_URL,
                "JobName"            : env.JOB_NAME.split("/").last(),
                "appVersion"         : appVersion,
                "artifact"           : uDeployArtifactName,
                "repo"               : gitRepositoryName,
            ]

            // ➤ Add all manifest files dynamically
            manifestMap.each { key, fileName ->
                versionProperties["Manifest-${key}"] = fileName
            }

            // Write each property to uDeploy
            versionProperties.each { key, value ->
                sh """
                    ${uDeployCli} \
                    --weburl ${uDeployUri} \
                    --username ${USERNAME} \
                    --password ${PASSWORD} \
                    setVersionProperty \
                    --component ${uDeployComponentName} \
                    --version ${uDeployComponentVersion} \
                    --name "${key}" \
                    --value "${value}"
                """
            }
        }
    }
}
