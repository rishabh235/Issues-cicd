node(env.dse_worker_node) {

    // Build parameters
    def gitRepositoryName = params.REPOSITORY_NAME
    def gitBranch         = params.BRANCH
    def gitPullRequestId  = params.PRID ? params.PRID : 'NA'

    ansiColor('xterm') {
        try {

            stage("Checkout Test Repo") {
                echo "🔁 Checking out repo: ${gitRepositoryName}  Branch: ${gitBranch}"

                git branch: gitBranch,
                    credentialsId: 'BitBucket_Access_Token',  // <-- Hardcoded credential ID
                    url: "https://bitbucket.glb.syfbank.com/scm/sbi/${gitRepositoryName}.git"
            }

            stage("Validate Squash Commit") {
                if (!params.SKIP_SQUASH_COMMIT_VALIDATION && gitPullRequestId != 'NA') {

                    echo "🔍 Checking commit count for PR: ${gitPullRequestId}"

                    def apiUrl = "https://bitbucket.glb.syfbank.com/rest/api/1.0/projects/SBI/repos/${gitRepositoryName}/pull-requests/${gitPullRequestId}/commits"

                    def response = sh(
                        script: """
                            curl -s -H "Authorization: Bearer ${BitBucket_Access_Token}" \
                                 -H "Accept: application/json" \
                                 "${apiUrl}"
                        """,
                        returnStdout: true
                    )

                    def parsedResponse = readJSON text: response
                    int commitCount = parsedResponse.values.size()

                    echo "📌 Commits in PR: ${commitCount}"

                    if (commitCount > 1) {
                        error("❌ More than 1 commit found. Please squash commits before merging PR.")
                    } else {
                        echo "✔ Validation Passed — Only 1 commit exists."
                    }

                } else {
                    echo "⚠ Skipped squash commit validation (Skip flag or no PRID)"
                }
            }

            stage("Dummy Build") {
                echo "🏗 Running dummy build — POC successful"
            }

        } catch(err) {
            echo "Pipeline failed: ${err}"
            currentBuild.result = 'FAILURE'
            throw err
        }
    }
}
