def call(def pcfFoundation = null, def fileType = 'manifest') {

    def yamlText = libraryResource('pipeline-global-config/foundation-manifests.yml')
    def foundationData = readYaml(text: yamlText)

    def section = foundationData[fileType]
    if (!section) {
        println "Section '${fileType}' not found. Returning empty."
        return [:]   // Always safe
    }

    // 1️⃣ QA PIPELINE (no foundation passed)
    if (!pcfFoundation) {
        // Merge all sub-maps inside prod section only
        if (!section.prod) {
            println "No prod section found. Returning empty."
            return [:]
        }

        println "Loaded ${section.prod.size()} ${fileType} files for QA pipeline"
        return section.prod   // <-- Map of key → filename
    }

    // 2️⃣ DEV PIPELINE (foundation provided)
    def files = []

    section.each { groupName, groupMap ->
        if (groupMap instanceof Map && groupMap.containsKey(pcfFoundation)) {
            def item = groupMap[pcfFoundation]
            files = (item instanceof String) ? [item] : item
        }
    }

    if (!files || files.isEmpty()) {
        println "No mapping found for foundation '${pcfFoundation}' under '${fileType}'"
        return []
    }

    println "Resolved ${fileType} file(s) for ${pcfFoundation}: ${files.join(',')}"
    return files   // List<String>
}
