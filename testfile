def call(String fileType = 'manifest') {

    def yamlText = libraryResource('pipeline-global-config/foundation-manifest-prod.yml')
    def foundationData = readYaml(text: yamlText)

    def section = foundationData[fileType]
    if (!section) {
        buildFailed("Section '${fileType}' not found in foundation-manifest-prod.yml")
    }

    println "Loaded ${section.size()} entries for '${fileType}'"
    return section
}


stage('validate: manifest') {
    logStage("validate-manifest") {

        def fileType = 'manifest'    // or "vars" based on pipeline
        def manifestMap = getManifestsMap(fileType)

        manifestMap.each { suffix, pcfManifest ->

            println "Validating ${suffix} => ${pcfManifest}"

            def envType = (suffix == 'ProdDal' || suffix == 'ProdPhx') ? 'np' : 'prod'

            if (fileExists(pcfManifest)) {
                println "Validating with splunk indextype: ${envType}"
                validateSplunkIndex(pcfManifest, envType)
            } else {
                buildFailed("No manifest file found: ${pcfManifest}")
            }
        }
    }
}


stage('udeploy: import-artifact') {
    logStage('udeploy-import-artifact') {

        def fileType = 'manifest'   // or 'vars'

        def manifestMap = getManifestsMap(fileType)

        // These suffixes MUST match the parameter order of your existing uDeploy function
        def expectedSuffixes = [
            'QAEast', 'QAWest',
            'QA1East1', 'QA1East2',
            'UATEast', 'UATWest',
            'UAT1East1', 'UAT1East2',
            'ProdDal', 'ProdPhx'
        ]

        expectedSuffixes.each { suffix ->
            def varName = "pcfManifestFile${suffix}"
            def value = manifestMap.containsKey(suffix) ? manifestMap[suffix] : ''
            this."${varName}" = value
            println "Set ${varName} = ${value}"
        }

        uDeployProdVersionImportAWS(
            gitProjectKey,
            gitRepositoryName,
            appVersion,
            pcfManifestFileQAEast,
            pcfManifestFileQAWest,
            pcfManifestFileQA1East1,
            pcfManifestFileQA1East2,
            pcfManifestFileUATEast,
            pcfManifestFileUATWest,
            pcfManifestFileUAT1East1,
            pcfManifestFileUAT1East2,
            pcfManifestFileProdDal,
            pcfManifestFileProdPhx
        )
    }
}




