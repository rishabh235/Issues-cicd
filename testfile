stage('udeploy: import-artifact') {
    logStage('udeploy-import-artifact')

    def fileType = 'manifest'

    // This will always return a list because your getFoundationManifests() enforces that
    def manifestList = getFoundationManifests(pcfFoundation, fileType)

    // Since validation already happened, this is safe:
    def pcfManifestFile = manifestList[0]

    println "Using manifest file for ${pcfFoundation}: ${pcfManifestFile}"

    uDeployDevVersionImport(
        gitRepositoryName,
        appVersion,
        pcfManifestFile,
        pcfRoute
    )
}
