node(env.dse_worker_node) {

    // Pipeline parameters
    def gitRepositoryName = params.REPOSITORY_NAME       // e.g. test-squash-repo
    def gitBranch         = params.BRANCH                // e.g. feature/test
    def gitPullRequestId  = params.PRID ? params.PRID : 'NA'

    ansiColor('xterm') {
        try {

            stage("Checkout Test Repo") {
                echo "🔁 Checking out repo: ${gitRepositoryName} | Branch: ${gitBranch}"

                git branch: gitBranch,
                    credentialsId: 'BITBUCKET_SSH',      // hardcoded credential ID
                    url: "https://bitbucket-dev.glb.syfbank.com/scm/ewc/${gitRepositoryName}.git"
            }

            stage("Validate Squash Commit") {

                if (!params.SKIP_SQUASH_COMMIT_VALIDATION && gitPullRequestId != 'NA') {

                    echo "🔍 Checking commit count for Pull Request ID: ${gitPullRequestId}"

                    def apiUrl = "https://bitbucket-dev.glb.syfbank.com/rest/api/1.0/projects/EWC/repos/${gitRepositoryName}/pull-requests/${gitPullRequestId}/commits"

                    def response = sh(
                        script: """
                            curl -s \
                                 -H "Authorization: Bearer ${BITBUCKET_ACCESS_TOKEN}" \
                                 -H "Accept: application/json" \
                                 "${apiUrl}"
                        """,
                        returnStdout: true
                    )

                    def parsedResponse = readJSON text: response
                    int commitCount = parsedResponse.values.size()

                    echo "📌 Commits detected in PR: ${commitCount}"

                    if (commitCount > 1) {
                        error("❌ ${commitCount} commits found — Please squash to a single commit before merging.")
                    } else {
                        echo "✔ Squash validation passed — Only one commit exists."
                    }

                } else {
                    echo "⚠ Skipping squash validation (Skip flag ON or PRID missing)"
                }
            }

            stage("Dummy Build") {
                echo "🏗 Dummy Build Stage — POC flow verified"
            }

        } catch (err) {
            echo "💥 Pipeline failed: ${err}"
            currentBuild.result = 'FAILURE'
            throw err
        }
    }
}
