stage('Squash Commit Validation') {
    echo "Squash Validation Stage Started"

    if (SKIP_SQUASH_COMMIT_VALIDATION) {
        echo "Skipping squash validation as requested"
    } else {
        echo "Validating squash commit for PR ID: ${gitPullRequestId}"

        if (!gitPullRequestId || gitPullRequestId == "NA") {
            echo "PR ID not provided. Skipping squash validation"
            return
        }

        // Fetch PR source branch locally
        sh """
            git fetch origin pull-requests/${gitPullRequestId}/from:prSourceBranch
        """

        // Count commits in PR
        def commitCount = sh(
            script: "git rev-list --count HEAD..prSourceBranch",
            returnStdout: true
        ).trim().toInteger()

        echo "Commit Count in PR: ${commitCount}"

        if (commitCount > 1) {
            error "❌ Please squash all commits. Current commit count: ${commitCount}"
        } else {
            echo "✔ Squash validation passed — Only one commit found"
        }
    }
}
