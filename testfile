def call(String pcfFoundation, String fileType = "manifest") {
    // Load YAML file from shared library
    def yamlText = libraryResource('pipeline-global-config/foundation-manifests.yml')
    def foundationData = readYaml text: yamlText

    // Validate section (vars or manifest)
    if (!foundationData.containsKey(fileType)) {
        error "❌ Invalid fileType '${fileType}'. Must be either 'vars' or 'manifest'."
    }

    def sectionData = foundationData[fileType]

    // Get foundation entry
    def manifestFile = sectionData[pcfFoundation]
    if (!manifestFile) {
        error "❌ No mapping found for foundation '${pcfFoundation}' under '${fileType}' section."
    }

    // Always return as a list (for consistent processing)
    def manifestList = (manifestFile instanceof String) ? [manifestFile] : manifestFile

    echo "✅ Resolved ${fileType} file(s) for foundation '${pcfFoundation}': ${manifestList.join(', ')}"
    return manifestList
}

