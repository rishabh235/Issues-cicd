stage('validate: manifest') {
    logStage('validate-manifest')

    // Always fetching manifest files for the pcfFoundation passed from Jenkins parameter
    def manifestList = getFoundationManifests(pcfFoundation, 'manifest')

    if (!manifestList || manifestList.isEmpty()) {
        buildFailed("No manifest files resolved for foundation: ${pcfFoundation}")
    }

    manifestList.each { manifestFile ->

        println "Validating manifest: ${manifestFile}"

        if (!fileExists(manifestFile)) {
            buildFailed("Manifest file not found: ${manifestFile}")
        }

        // ✅ Special logic: ProdDal & ProdPhx must use 'np'
        def indexType =
            (manifestFile.contains('prod-dal') || manifestFile.contains('prod-phx')) ?
                'np' :
                'prod'

        println "Validating Splunk index type: ${indexType}"

        validateSplunkIndex(manifestFile, indexType)
    }
}

