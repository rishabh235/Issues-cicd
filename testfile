def call(def repositoryName, def repositoryId, def groupId, def artifactId, def appVersion) {

    def envProperty = loadEnvironmentProperties()
    def mavenTool = envProperty.maven_upload_tool
    def defaultJdk = envProperty.default_jdk
    def nexusRepoBaseUrl = envProperty.nexus_repo_base_url
    def buildType = getAppBuildType()

    println "INFO: Nexus artifact uploading to repository: ${repositoryName}"
    println "INFO: The app version uploading: ${appVersion}"
    println "INFO: Build type detected: ${buildType}"

    if (repositoryName.contains('snapshots') && !appVersion.contains('SNAPSHOT')) {
        buildFailed("Attempting to upload a non-snapshot version to snapshot repo.")
    }

    // --------------------------------------------
    // Determine artifact JAR path (Maven vs Gradle)
    // --------------------------------------------
    def filePath = ""
    if (buildType == 'maven') {
        filePath = "target/${artifactId}-${appVersion}.jar"
    }
    else if (buildType == 'gradle') {
        filePath = "build/libs/${artifactId}-${appVersion}.jar"
    }
    else {
        buildFailed("Unsupported build type '${buildType}' during Nexus upload.")
    }

    if (!fileExists(filePath)) {
        buildFailed("Artifact file not found at: ${filePath}")
    }

    // -----------------------------------------------------
    // For GRADLE: Generate temporary POM file dynamically
    // -----------------------------------------------------
    def pomFile = "pom.xml"
    if (buildType == 'gradle') {
        pomFile = "generated-pom.xml"
        writeFile(
            file: pomFile,
            text: """
                <project xmlns="http://maven.apache.org/POM/4.0.0"
                         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
                    <modelVersion>4.0.0</modelVersion>
                    <groupId>${groupId}</groupId>
                    <artifactId>${artifactId}</artifactId>
                    <version>${appVersion}</version>
                    <packaging>jar</packaging>
                    <name>${artifactId}</name>
                </project>
            """
        )
        println "INFO: Temporary POM generated for Gradle: ${pomFile}"
    }

    // -----------------------------------------------------
    // Common Maven deploy command
    // -----------------------------------------------------
    withEnv(["JAVA_HOME=${tool defaultJdk}",
             "PATH+MAVEN=${tool defaultJdk}/bin:${tool mavenTool}/bin"]) {

        // For Maven, versions:set is valid
        if (buildType == 'maven') {
            sh "mvn versions:set -q -DnewVersion=${appVersion}"
        }

        sh """
            mvn -V -B -e deploy:deploy-file \
                -DpomFile=${pomFile} \
                -Durl=${nexusRepoBaseUrl}/${repositoryName}/ \
                -DrepositoryId=${repositoryId} \
                -DgroupId=${groupId} \
                -DartifactId=${artifactId} \
                -Dversion=${appVersion} \
                -Dpackaging=jar \
                -Dfile=${filePath}
        """

        if (buildType == 'maven') {
            sh "mvn versions:revert -q"
        }
    }
}
