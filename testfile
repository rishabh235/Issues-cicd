
def call() {

    // Only run for PR builds
    if (!env.CHANGE_ID) {
        echo "Not a PR build. Skipping single-commit validation."
        return
    }

    echo "Validating PR commit policy"
    echo "PR ID         : ${env.CHANGE_ID}"
    echo "Source Branch : ${env.CHANGE_BRANCH}"
    echo "Target Branch : ${env.CHANGE_TARGET}"

    // Make sure target branch is available
    sh """
        git fetch origin ${env.CHANGE_TARGET}
    """

    // Count commits between target and PR HEAD
    def commitCount = sh(
        script: "git rev-list --count origin/${env.CHANGE_TARGET}..HEAD",
        returnStdout: true
    ).trim().toInteger()

    echo "Commit count in PR: ${commitCount}"

    if (commitCount > 1) {
        error """
❌ PR VALIDATION FAILED

This PR contains ${commitCount} commits.
Only ONE commit is allowed.

Please squash your commits before raising the PR.

How to fix:
git rebase -i origin/${env.CHANGE_TARGET}
# squash commits
git push -f
"""
    }

    echo "✅ PR commit validation passed"
}
