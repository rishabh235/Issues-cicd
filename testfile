stage('udeploy: import-artifact') {
    logStage('udeploy-import-artifact') {
        script {
            // choose fileType for this pipeline ('manifest' or 'vars')
            def fileType = 'manifest'   // or 'vars' for vars-based pipelines

            // 1) load the map (suffix -> filename)
            def manifestMap = getManifestsMap(fileType)

            // 2) Define the expected suffixes in the exact order your uDeploy function expects
            // Adjust the list below to match the parameter order used by uDeployProdVersionImportAWS
            def expectedSuffixes = [
                'QADal','QAPhx','UATDal','UATPhx',
                'QAEast','QAWest','QA1East1','QA1East2',
                'UATEast','UATWest','UAT1East1','UAT1East2',
                'ProdDal','ProdPhx'
            ]

            // 3) For backward compatibility, create variables like pcfManifestFileQADal, etc.
            expectedSuffixes.each { suffix ->
                def varName = "pcfManifestFile${suffix}"
                def value = manifestMap.containsKey(suffix) ? manifestMap[suffix] : ''
                this."${varName}" = value
                echo "Set ${varName} = ${value}"
            }

            // 4) Now call the existing function unchanged (variables are present)
            uDeployProdVersionImportAWS(
                gitProjectKey, gitRepositoryName, appVersion,
                pcfManifestFileQADal, pcfManifestFileQAPhx,
                pcfManifestFileUATDal, pcfManifestFileUATPhx,
                pcfManifestFileQAEast, pcfManifestFileQAWest,
                pcfManifestFileQA1East1, pcfManifestFileQA1East2,
                pcfManifestFileUATEast, pcfManifestFileUATWest,
                pcfManifestFileUAT1East1, pcfManifestFileUAT1East2,
                pcfManifestFileProdDal, pcfManifestFileProdPhx
            )
        }
    }
}
