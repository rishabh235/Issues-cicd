def call(def pcfFoundation = null, def fileType = 'manifest') {

    def yamlText = libraryResource('pipeline-global-config/foundation-manifests.yml')
    def foundationData = readYaml(text: yamlText)

    def section = foundationData[fileType]
    if (!section) {
        return []
    }

    // -----------------------------
    // QA PIPELINE (no foundation)
    // -----------------------------
    if (!pcfFoundation) {

        def all = []

        // np section
        if (section.np instanceof Map) {
            section.np.each { key, file ->
                all << [ key: key, file: file, indexType: 'np' ]
            }
        }

        // prod section
        if (section.prod instanceof Map) {
            section.prod.each { key, file ->
                all << [ key: key, file: file, indexType: 'prod' ]
            }
        }

        return all
    }

    // -----------------------------
    // DEV PIPELINE (with foundation)
    // -----------------------------
    def result = []

    section.each { group, groupMap ->
        if (groupMap instanceof Map && groupMap.containsKey(pcfFoundation)) {
            def file = groupMap[pcfFoundation]
            def idx = (group == 'prod') ? 'prod' : 'np'
            result << [ key: pcfFoundation, file: file, indexType: idx ]
        }
    }

    return result
}
