def call(String sourceBranch,
         String targetBranch,
         String prId,
         boolean forceCheck = false) {

    // Decide whether to run validation
    if (!forceCheck && (!prId || prId == 'NA')) {
        echo "Not a PR build and FORCE_ATOMIC_CHECK=false. Skipping atomic commit validation."
        return
    }

    if (!sourceBranch?.trim() || !targetBranch?.trim()) {
        error "Source or Target branch is empty. Cannot validate atomic commit."
    }

    sourceBranch = sourceBranch.replaceAll('^refs/heads/', '')
    targetBranch = targetBranch.replaceAll('^refs/heads/', '')

    echo "Atomic commit validation"
    echo "Source branch : ${sourceBranch}"
    echo "Target branch : ${targetBranch}"
    echo "PR ID         : ${prId ?: 'N/A'}"
    echo "Force check   : ${forceCheck}"

    // Fetch both branches explicitly
    sh "git fetch origin ${sourceBranch}"
    sh "git fetch origin ${targetBranch}"

    def commitCount = sh(
        script: "git rev-list --count origin/${targetBranch}..origin/${sourceBranch}",
        returnStdout: true
    ).trim()

    echo "Commits introduced by '${sourceBranch}' vs '${targetBranch}': ${commitCount}"

    if (commitCount.toInteger() > 1) {
        error """
❌ ATOMIC COMMIT ENFORCEMENT FAILED
Branch '${sourceBranch}' introduces ${commitCount} commits compared to '${targetBranch}'.
Please squash commits before merge.
        """
    }

    echo "✅ Atomic commit validation passed."
}
