def manifestList = getFoundationManifests("manifest", null)

manifestList.each { manifestFile ->

    if (!manifestFile?.trim()) {
        echo "Skipping empty manifest entry..."
        return
    }

    def envType = (manifestFile.contains("prod-dal") 
                   || manifestFile.contains("prod-phx")) ? "np" : "prod"

    if (fileExists(manifestFile)) {
        validateSplunkIndex(manifestFile, envType)
    } else {
        echo "Manifest file not found: ${manifestFile}, skipping..."
    }
}
