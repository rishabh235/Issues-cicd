def call(def repositoryName, def repositoryId, def groupId, def artifactId, def appVersion, def buildType) {

    def envProperty = loadEnvironmentProperties()
    def mavenTool = envProperty.maven_upload_tool
    def defaultJdk = envProperty.default_jdk
    def nexusRepoBaseUrl = envProperty.nexus_repo_base_url

    println "INFO: Nexus artifact uploading to repository: ${repositoryName}"
    println "INFO: App version uploading: ${appVersion}"
    println "INFO: Build type detected: ${buildType}"

    if (repositoryName.contains('snapshots') && !appVersion.contains('SNAPSHOT')) {
        buildFailed("Attempting to upload a non-snapshot version to the Nexus snapshot repository.")
    }

    // Choose pom file location for Gradle BOM
    def gradlePomFile = "build/publications/mavenJava/pom-default.xml"

    withEnv(["JAVA_HOME=${tool defaultJdk}", "PATH+MAVEN=${tool defaultJdk}/bin:${tool mavenTool}/bin"]) {

        if (buildType == "maven") {

            sh "mvn versions:set -q -DnewVersion=${appVersion}"

            sh """
                mvn -V -B -e deploy:deploy-file \
                -DpomFile=pom.xml \
                -Durl=${nexusRepoBaseUrl}/${repositoryName}/ \
                -DrepositoryId=${repositoryId} \
                -DgroupId=${groupId} \
                -DartifactId=${artifactId} \
                -Dversion=${appVersion} \
                -Dpackaging=pom \
                -Dfile=pom.xml
            """

            sh "mvn versions:revert -q"

        } else if (buildType == "gradle") {

            if (!fileExists(gradlePomFile)) {
                buildFailed("Gradle BOM pom file not found at ${gradlePomFile}")
            }

            sh """
                mvn -V -B -e deploy:deploy-file \
                -Dfile=${gradlePomFile} \
                -Durl=${nexusRepoBaseUrl}/${repositoryName}/ \
                -DrepositoryId=${repositoryId} \
                -DgroupId=${groupId} \
                -DartifactId=${artifactId} \
                -Dversion=${appVersion} \
                -Dpackaging=pom
            """

        } else {

            buildFailed("Unsupported build type detected: '${buildType}'.")
        }
    }
}


