stage('validate: manifest') {
    logStage('validate-manifest') {
        script {
            // choose fileType for this pipeline ('manifest' or 'vars')
            def fileType = 'manifest'   // change to 'vars' if pipeline uses vars files

            // load map (suffix -> filename)
            def manifestMap = getManifestsMap(fileType)

            // Validate all files (loop over map values)
            manifestMap.each { suffix, filename ->
                echo "🔍 Validating ${suffix} => ${filename}"
                if (fileExists(filename)) {
                    validateSplunkIndex(filename, 'prod')   // or 'dev' depending on pipeline
                } else {
                    buildFailed("No manifest file found: ${filename}")
                }
            }
        }
    }
}
