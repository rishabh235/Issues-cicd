stage('nexus: publish artifact') {
    logStage('nexus-publish-artifact') {

        def pom = null

        // Detect Maven or Gradle BOM pom file
        if (fileExists('pom.xml')) {
            pom = readMavenPom(file: 'pom.xml')
            println "INFO: Detected Maven project"
        } else if (fileExists('build/publications/mavenJava/pom-default.xml')) {
            pom = readMavenPom(file: 'build/publications/mavenJava/pom-default.xml')
            println "INFO: Detected Gradle BOM project"
        } else {
            buildFailed("Unable to publish: No pom.xml or Gradle BOM pom found.")
        }

        // Upload BOM if packaging = pom
        if (pom.packaging.toString().contains('pom')) {
            println "INFO: Uploading BOM POM (${pom.artifactId}-${pom.version}.pom) to Nexus repository"

            nexusArtifactoryPomUpload(
                'snapshots',
                'internalMavenSnapshotRepository',
                getAppGroupId(),
                getAppArtifactId(),
                appVersion
            )

        } else {
            println "INFO: Uploading artifact JAR to Nexus"

            nexusArtifactoryUpload(
                'snapshots',
                'internalMavenSnapshotRepository',
                getAppGroupId(),
                getAppArtifactId(gitRepositoryName),
                appVersion
            )
        }
    }
}
